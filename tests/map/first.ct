/* Section 3 of std/map/README.md, verbatim.
 *
 * The gate builds and runs every *.ct in tests/map/, so the README's
 * opening program is compiled on every run instead of rotting in the docs.
 *
 *   ct build -I . tests/map/first.ct -o /tmp/first && /tmp/first
 */
import std::map::Map;
import std::test::Test;

int main(void)
{
    Test t;
    Test *tp = &t;
    MapStrInt m;
    MapStrInt *mp = &m;
    int v;

    tp->init();

    tp->checkEqInt(mp->init(8), 0, "init is the first step");
    tp->checkEqInt(mp->put("one", 1), 0, "put");
    tp->checkEqInt(mp->get("one", &v), 0, "get");
    tp->checkEqInt(v, 1, "the stored value");
    tp->checkEqInt(mp->get("two", &v), -1, "a missing key");
    tp->checkEqInt(mp->len(), 1, "len");
    mp->free();

    return tp->report();
}

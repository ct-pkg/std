/* std::str - the empty string, a string of one repeated byte, every find
 * miss, the full slice bounds matrix, NULL / zero-capacity buffers, the
 * in-place case folding, the memcpy pair and the two C parsers. */
import std::str::String;
import std::test::Test;

int main(void)
{
    Test t;
    Test *tp = &t;
    char buf[32];
    char word[16];
    char dst[8];
    char src[8];
    char emptybuf[1];
    char *empty = "";
    char *same = "aaaa";
    char *hello = "hello";
    char *nul = 0;
    char *pnull = 0;

    tp->init();

    /* ---- empty string -------------------------------------------------- */
    tp->checkEqInt(empty.len(), 0, "String.len: empty");
    tp->checkEqInt(empty.find(""), 0, "String.find: empty needle in empty");
    tp->checkEqInt(empty.find("x"), -1, "String.find: no hit in empty");
    tp->checkEqInt(empty.findChar('x'), -1, "String.findChar: no hit in empty");
    tp->checkEqInt(empty.findChar(0), 0, "String.findChar: the terminator is at 0");
    tp->checkEqInt(empty.startsWith(""), 1, "String.startsWith: empty prefix");
    tp->checkEqInt(empty.endsWith(""), 1, "String.endsWith: empty suffix");
    tp->checkEqInt(empty.copy(buf, 1), 0, "String.copy: empty fits cap 1");
    tp->checkEqStr(buf, "", "String.copy: empty value");
    tp->checkEqInt(empty.copy(buf, 0), -1, "String.copy: cap 0 fails");
    tp->checkEqInt(empty.slice(0, 0, buf, 1), 0, "String.slice: empty range fits cap 1");
    tp->checkEqStr(buf, "", "String.slice: empty range value");
    tp->checkEqInt(empty.concat("", buf, 1), 0, "String.concat: two empties fit cap 1");
    tp->checkEqStr(buf, "", "String.concat: two empties value");
    tp->checkEqInt(empty.compare(""), 0, "String.compare: empty vs empty");
    emptybuf[0] = 0;
    tp->checkEqInt(emptybuf.toLower(), 0, "String.toLower: empty succeeds");
    tp->checkEqStr(emptybuf, "", "String.toLower: empty stays empty");
    tp->checkEqInt(emptybuf.toUpper(), 0, "String.toUpper: empty succeeds");
    tp->checkEqStr(emptybuf, "", "String.toUpper: empty stays empty");

    /* ---- one repeated byte --------------------------------------------- */
    tp->checkEqInt(same.len(), 4, "String.len: 'aaaa'");
    tp->checkEqInt(same.find("aa"), 0, "String.find: overlapping hit at 0");
    tp->checkEqInt(same.find("aaa"), 0, "String.find: three of four");
    tp->checkEqInt(same.find("aaaaa"), -1, "String.find: needle longer than input");
    tp->checkEqInt(same.findChar('a'), 0, "String.findChar: first of four");
    tp->checkEqInt(same.startsWith("aaa"), 1, "String.startsWith: 'aaa'");
    tp->checkEqInt(same.startsWith("aab"), 0, "String.startsWith: mismatch at the end");
    tp->checkEqInt(same.endsWith("aaa"), 1, "String.endsWith: 'aaa'");
    tp->checkEqInt(same.endsWith("ba"), 0, "String.endsWith: mismatch at the start");
    tp->checkEqInt(same.slice(1, 3, buf, 32), 0, "String.slice: middle of repeated bytes");
    tp->checkEqStr(buf, "aa", "String.slice: repeated value");
    tp->checkEqInt(same.compare("aaaa"), 0, "String.compare: repeated equal");

    /* ---- find, including the empty needle ------------------------------ */
    tp->checkEqInt(hello.find(""), 0, "String.find: empty needle in a non-empty string");
    tp->checkEqInt(hello.find("hello!"), -1, "String.find: needle one byte longer");
    tp->checkEqInt(hello.find("l"), 2, "String.find: single-byte hit");
    tp->checkEqInt(hello.findChar(0), 5, "String.findChar: terminator of 'hello'");

    /* ---- slice bounds -------------------------------------------------- */
    tp->checkEqInt(hello.slice(-1, 2, buf, 32), -1, "String.slice: start < 0");
    tp->checkEqInt(hello.slice(3, 2, buf, 32), -1, "String.slice: end < start");
    tp->checkEqInt(hello.slice(0, 6, buf, 32), -1, "String.slice: end > len");
    tp->checkEqInt(hello.slice(6, 6, buf, 32), -1, "String.slice: start > len");
    tp->checkEqInt(hello.slice(5, 5, buf, 1), 0, "String.slice: empty range at the end");
    tp->checkEqStr(buf, "", "String.slice: empty range at the end value");
    tp->checkEqInt(hello.slice(1, 4, buf, 4), 0, "String.slice: cap exactly");
    tp->checkEqStr(buf, "ell", "String.slice: cap exactly value");
    tp->checkEqInt(hello.slice(1, 4, buf, 3), -1, "String.slice: cap one short");
    tp->checkEqInt(hello.slice(0, 2, pnull, 32), -1, "String.slice: NULL buffer");
    tp->checkEqInt(hello.slice(0, 2, buf, 0), -1, "String.slice: cap 0");

    /* ---- copy / concat ------------------------------------------------- */
    tp->checkEqInt(hello.copy(pnull, 32), -1, "String.copy: NULL buffer");
    tp->checkEqInt(hello.copy(buf, 0), -1, "String.copy: cap 0");
    tp->checkEqInt(hello.copy(buf, 6), 0, "String.copy: cap exactly len + 1");
    tp->checkEqStr(buf, "hello", "String.copy: cap exactly value");
    tp->checkEqInt("ab".concat("cd", pnull, 32), -1, "String.concat: NULL buffer");
    tp->checkEqInt("ab".concat("cd", buf, 0), -1, "String.concat: cap 0");
    tp->checkEqInt(nul.concat("cd", buf, 32), -1, "String.concat: NULL left side");
    tp->checkEqInt("ab".concat(nul, buf, 32), -1, "String.concat: NULL right side");

    /* ---- in-place case folding ----------------------------------------- */
    tp->checkEqInt("abc123!".copy(word, 16), 0, "String.copy: lower sample");
    tp->checkEqInt(word.toLower(), 0, "String.toLower: already lower");
    tp->checkEqStr(word, "abc123!", "String.toLower: leaves digits and punctuation");
    tp->checkEqInt(word.toUpper(), 0, "String.toUpper: from lower");
    tp->checkEqStr(word, "ABC123!", "String.toUpper: value");
    tp->checkEqInt("aBc".copy(word, 16), 0, "String.copy: mixed sample");
    tp->checkEqInt(word.toUpper(), 0, "String.toUpper: mixed");
    tp->checkEqStr(word, "ABC", "String.toUpper: mixed value");
    tp->checkEqInt(word.toLower(), 0, "String.toLower: mixed");
    tp->checkEqStr(word, "abc", "String.toLower: mixed value");

    /* ---- compare, including a NULL receiver ---------------------------- */
    tp->checkEqInt("ab".compare("abc"), -1, "String.compare: shorter prefix");
    tp->checkEqInt("abc".compare("ab"), 1, "String.compare: longer string");
    tp->checkEqInt(nul.compare(""), 0, "String.compare: NULL is empty");
    tp->checkEqInt(nul.compare("a"), -1, "String.compare: NULL is less than 'a'");
    tp->checkEqInt("a".compare(nul), 1, "String.compare: 'a' is greater than NULL");

    /* ---- copyFrom / copyTo: exactly n bytes, no NUL --------------------- */
    dst[0] = 'X'; dst[1] = 'Y'; dst[2] = 'Z'; dst[3] = 0;
    dst.copyFrom("abc", 3);
    dst[3] = 0;
    tp->checkEqStr(dst, "abc", "String.copyFrom: three bytes");
    dst.copyFrom("xyz", 0);
    tp->checkEqStr(dst, "abc", "String.copyFrom: n == 0 is a no-op");
    dst.copyFrom(nul, 3);
    tp->checkEqStr(dst, "abc", "String.copyFrom: NULL source is a no-op");
    src[0] = 'a'; src[1] = 'b'; src[2] = 'c'; src[3] = 0;
    dst[0] = 'X'; dst[1] = 'Y'; dst[2] = 'Z'; dst[3] = 0;
    src.copyTo(dst, 3);
    dst[3] = 0;
    tp->checkEqStr(dst, "abc", "String.copyTo: three bytes");
    src.copyTo(dst, 0);
    tp->checkEqStr(dst, "abc", "String.copyTo: n == 0 is a no-op");

    /* ---- the C parsers ------------------------------------------------- */
    tp->checkEqInt("-42".toInt(), -42, "String.toInt: negative");
    tp->checkEqInt("  -7".toInt(), -7, "String.toInt: leading spaces");
    tp->checkEqInt("12abc".toInt(), 12, "String.toInt: stops at the first non-digit");
    tp->checkEqInt(empty.toInt(), 0, "String.toInt: empty");
    tp->checkEqInt("abc".toInt(), 0, "String.toInt: no digits");
    tp->checkEqInt(nul.toInt(), 0, "String.toInt: NULL receiver");
    tp->checkTrue("-2.25".toDouble() == -2.25, "String.toDouble: negative");
    tp->checkTrue("1e3".toDouble() == 1000.0, "String.toDouble: exponent");
    tp->checkTrue("abc".toDouble() == 0.0, "String.toDouble: no number");
    tp->checkTrue(empty.toDouble() == 0.0, "String.toDouble: empty");
    tp->checkTrue(nul.toDouble() == 0.0, "String.toDouble: NULL receiver");

    return tp->report();
}

/* Broader String coverage; the working docs are in std/str/README.md.
 *
 * The gate builds and runs it (tests/run.sh drives every *.ct in this
 * directory), so a broken example fails the build instead of rotting in the
 * docs.
 *
 * Build and run by hand:
 *   ct build -I . tests/str/guide.ct -o /tmp/guide && /tmp/guide
 */
import std::str::String;
import std::test::Test;

int main(void)
{
    Test t;
    Test *tp = &t;
    char buf[16];
    char word[8];
    char *s = "Hello, ct";

    tp->init();

    /* 1. Read: every index is a BYTE offset, every length is in BYTES. */
    tp->check_eq_int(s.len(), 9, "len");
    tp->check_eq_int(s.find("ct"), 7, "find");
    tp->check_eq_int(s.find("zz"), -1, "find misses");
    tp->check_eq_int(s.find_char(','), 5, "find_char");
    tp->check_eq_int(s.find_char('z'), -1, "find_char misses");
    tp->check_eq_int(s.starts_with("Hello"), 1, "starts_with hit");
    tp->check_eq_int(s.starts_with("hello"), 0, "starts_with is case sensitive");
    tp->check_eq_int(s.ends_with("ct"), 1, "ends_with hit");
    tp->check_eq_int(s.ends_with("tc"), 0, "ends_with miss");
    tp->check_eq_int("abc".compare("abd"), -1, "compare orders like strcmp");

    /* 2. Write into a buffer the caller owns: `out` and `cap` are arguments. */
    tp->check_eq_int(s.copy(buf, 16), 0, "copy");
    tp->check_eq_str(buf, "Hello, ct", "copy result");
    tp->check_eq_int(s.copy(buf, 9), -1, "copy needs room for the NUL");

    tp->check_eq_int(s.slice(0, 5, buf, 16), 0, "slice");
    tp->check_eq_str(buf, "Hello", "slice is half-open [start, end)");
    tp->check_eq_int(s.slice(0, 99, buf, 16), -1, "slice past the end");

    tp->check_eq_int("Hello, ".concat("ct", buf, 16), 0, "concat");
    tp->check_eq_str(buf, "Hello, ct", "concat result");
    tp->check_eq_int("Hello, ".concat("ct", buf, 9), -1, "concat needs room for the NUL");

    /* 3. Case folding: the receiver is only read, the result goes to a buffer.
       A literal receiver is safe here because nothing writes through it. */
    tp->check_eq_int("Hello".to_lower(word, 8), 0, "to_lower");
    tp->check_eq_str(word, "hello", "to_lower result");
    tp->check_eq_int("Hello".to_upper(word, 8), 0, "to_upper");
    tp->check_eq_str(word, "HELLO", "to_upper result");
    tp->check_eq_int("Hello".to_upper(word, 5), -1, "to_upper needs room for the NUL");

    /* 4. Bytes, not characters: "é" is one character and two bytes. */
    tp->check_eq_int("é".len(), 2, "len counts bytes");
    tp->check_eq_int("é".find_char('z'), -1, "indexes are byte offsets too");

    return tp->report();
}

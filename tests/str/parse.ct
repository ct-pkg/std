/* std::str::String - the two C parsers behind to_int / to_double. */
import std::str::String;
import std::test::Test;

int main(void)
{
    Test t;
    Test *tp = &t;
    char *num = "42";
    char *flt = "3.5";
    char *bad = "abc";

    tp->init();

    tp->check_eq_int(num.to_int(), 42, "to_int");
    tp->check_eq_int((int)flt.to_double(), 3, "to_double");
    tp->check_eq_int(bad.to_int(), 0, "to_int on a non-number");

    return tp->report();
}

/* std::str - positive path and the bounded / missing cases.
 *
 * `std::str`'s only CT entry is the OO spelling from `String.m.ct`; each call
 * is a static mapping onto the `std_str_*` C functions in String.shim.h, so
 * these checks cover both the spelling and the code. */
import std::str::String;
import std::test::Test;

int main(void)
{
    Test t;
    Test *tp = &t;
    char buf[32];
    char word[16];
    char *s = "hello";
    const char *cs = "hello";

    tp->init();

    tp->check_eq_int(s.len(), 5, "len");
    tp->check_eq_int("hi".len(), 2, "literal receiver");
    tp->check_eq_int(cs.len(), 5, "const receiver");
    tp->check_eq_int(s.find("ll"), 2, "find a hit");
    tp->check_eq_int(s.find("z"), -1, "find a miss");
    tp->check_eq_int(s.find_char('l'), 2, "find_char a hit");
    tp->check_eq_int(s.find_char('z'), -1, "find_char a miss");
    tp->check_true(s.starts_with("he"), "prefix hit");
    tp->check_true(!s.starts_with("el"), "prefix miss");
    tp->check_true(s.ends_with("lo"), "suffix hit");
    tp->check_true(!s.ends_with("ol"), "suffix miss");
    tp->check_true(!"hi".ends_with("hello"), "suffix longer than input");

    tp->check_eq_int(s.copy(buf, 32), 0, "copy fits");
    tp->check_eq_str(buf, "hello", "copy value");
    tp->check_eq_int(s.copy(buf, 5), -1, "copy needs room for the NUL");

    tp->check_eq_int(s.slice(1, 3, buf, 32), 0, "slice");
    tp->check_eq_str(buf, "el", "slice value");
    tp->check_eq_int(s.slice(4, 2, buf, 32), -1, "slice reversed range");
    tp->check_eq_int(s.slice(0, 9, buf, 32), -1, "slice past the end");

    tp->check_eq_int("ab".concat("cd", buf, 32), 0, "concat fits");
    tp->check_eq_str(buf, "abcd", "concat value");
    tp->check_eq_int("ab".concat("cd", buf, 5), 0, "concat fits exactly");
    tp->check_eq_int("ab".concat("cd", buf, 4), -1, "concat needs room for the NUL");

    tp->check_eq_int(buf.to_lower(word, 16), 0, "to_lower");
    tp->check_eq_str(word, "abcd", "to_lower value");
    tp->check_eq_int(buf.to_upper(word, 16), 0, "to_upper");
    tp->check_eq_str(word, "ABCD", "to_upper value");

    tp->check_eq_int("abc".compare("abd"), -1, "compare less");
    tp->check_eq_int("abc".compare("abc"), 0, "compare equal");
    tp->check_eq_int("abd".compare("abc"), 1, "compare greater");

    /* The receiver is only read, so a literal works and `word` receives it. */
    tp->check_eq_int("Hello!".to_lower(word, 16), 0, "to_lower on a literal");
    tp->check_eq_str(word, "hello!", "to_lower value");
    tp->check_eq_int("Hello!".to_upper(word, 16), 0, "to_upper on a literal");
    tp->check_eq_str(word, "HELLO!", "to_upper value");
    tp->check_eq_int("Hello!".to_upper(word, 6), -1, "to_upper needs room for the NUL");

    return tp->report();
}

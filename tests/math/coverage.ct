/* std::math - the namespace pair (Math), the float host (Float) and the double
 * host (Real): non-finite values, signed zeros, the extreme magnitudes, the
 * to_str capacity contract and the four-slot to_string ring. */
import std::math::Math;
import std::math::Real;
import std::test::Test;

#include <float.h>
#include <math.h>
#include <stdlib.h>
#include <string.h>

int main(void)
{
    Test t;
    Test *tp = &t;
    char buf[64];
    char sent[8];
    char *nullbuf = 0;
    char *r0;
    char *r1;
    char *r2;
    char *r3;
    char *r4;
    double zero = 0.0;
    double nzero = -0.0;
    double one = 1.0;
    double x = 16.0;
    double neg = -3.5;
    double d26 = 2.6;
    double d25 = 2.5;
    double dn25 = -2.5;
    double half = -0.5;
    double nan = zero / zero;
    double inf = one / zero;
    double ninf = -one / zero;
    double dmax = DBL_MAX;
    double dmin = DBL_MIN;
    double dtiny = 5e-324;
    double sqneg;
    float fneg = -2.5f;
    float fz = -0.0f;
    float f9 = 9.0f;
    float fhalf = -0.5f;
    float f25 = 2.5f;
    float fn25 = -2.5f;

    tp->init();

    /* ---- Math: the namespace host ------------------------------------- */
    tp->check_true(std::math::Math.sqrt(zero) == 0.0, "Math.sqrt: 0");
    tp->check_true(std::math::Math.sqrt(x) == 4.0, "Math.sqrt: 16");
    tp->check_true(std::math::Math.sqrt(2.25) == 1.5, "Math.sqrt: 2.25");
    sqneg = std::math::Math.sqrt(-one);
    tp->check_eq_int(sqneg.is_nan(), 1, "Math.sqrt: a negative argument is NaN");
    tp->check_true(std::math::Math.fabs(neg) == 3.5, "Math.fabs: -3.5");
    tp->check_true(std::math::Math.fabs(nzero) == 0.0, "Math.fabs: -0 is 0");
    tp->check_eq_int(signbit(std::math::Math.fabs(nzero)), 0, "Math.fabs: -0 loses its sign");
    tp->check_eq_int(std::math::Math.fabs(ninf).is_inf(), 1, "Math.fabs: -inf is inf");
    tp->check_eq_int(std::math::Math.fabs(nan).is_nan(), 1, "Math.fabs: NaN stays NaN");

    /* ---- Float -------------------------------------------------------- */
    tp->check_true(fneg.abs() == 2.5f, "Float.abs: -2.5");
    tp->check_eq_int(signbit(fz.abs()), 0, "Float.abs: -0 loses its sign");
    tp->check_true(f9.sqrt() == 3.0f, "Float.sqrt: 9");
    tp->check_true(fhalf.floor() == -1.0f, "Float.floor: -0.5");
    tp->check_true(fhalf.ceil() == 0.0f, "Float.ceil: -0.5 is zero");
    tp->check_eq_int(signbit(fhalf.ceil()), 1, "Float.ceil: -0.5 keeps a negative zero");
    tp->check_true(fneg.floor() == -3.0f, "Float.floor: -2.5");
    tp->check_true(fneg.ceil() == -2.0f, "Float.ceil: -2.5");
    tp->check_true(fneg.round() == -3.0f, "Float.round: -2.5 rounds away from zero");
    tp->check_true(f25.round() == 3.0f, "Float.round: 2.5 rounds away from zero");
    tp->check_true(fn25.round() == -3.0f, "Float.round: -2.5");

    /* ---- Real: arithmetic --------------------------------------------- */
    tp->check_true(x.sqrt() == 4.0, "Real.sqrt: 16");
    tp->check_true(neg.abs() == 3.5, "Real.abs: -3.5");
    tp->check_true(neg.floor() == -4.0, "Real.floor: -3.5");
    tp->check_true(neg.ceil() == -3.0, "Real.ceil: -3.5");
    tp->check_true(neg.round() == -4.0, "Real.round: -3.5");
    tp->check_true(d25.round() == 3.0, "Real.round: 2.5");
    tp->check_true(dn25.round() == -3.0, "Real.round: -2.5");
    tp->check_true(half.floor() == -1.0, "Real.floor: -0.5");
    tp->check_true(half.ceil() == 0.0, "Real.ceil: -0.5 is zero");
    tp->check_eq_int(signbit(half.ceil()), 1, "Real.ceil: -0.5 keeps a negative zero");
    tp->check_eq_int(signbit(nzero.floor()), 1, "Real.floor: -0 keeps its sign");
    tp->check_eq_int(signbit(nzero.ceil()), 1, "Real.ceil: -0 keeps its sign");
    tp->check_eq_int(signbit(nzero.round()), 1, "Real.round: -0 keeps its sign");

    /* ---- Real: classification ----------------------------------------- */
    tp->check_eq_int(nan.is_nan(), 1, "Real.is_nan: NaN");
    tp->check_eq_int(one.is_nan(), 0, "Real.is_nan: 1");
    tp->check_eq_int(inf.is_inf(), 1, "Real.is_inf: +inf");
    tp->check_eq_int(ninf.is_inf(), 1, "Real.is_inf: -inf");
    tp->check_eq_int(one.is_inf(), 0, "Real.is_inf: 1");
    tp->check_eq_int(inf.is_nan(), 0, "Real.is_nan: inf is not NaN");

    /* ---- Real: to_str --------------------------------------------------- */
    buf[0] = 0;
    tp->check_true(d26.to_str(buf, 4) == buf, "Real.to_str: returns the buffer");
    tp->check_eq_str(buf, "2.6", "Real.to_str: cap exactly");
    tp->check_true(d26.to_str(buf, 3) == buf, "Real.to_str: cap one short returns the buffer");
    tp->check_eq_str(buf, "2.", "Real.to_str: cap one short truncates silently");
    tp->check_true(d26.to_str(nullbuf, 32) == 0, "Real.to_str: NULL buffer returns NULL");
    sent[0] = 'X'; sent[1] = 'Y'; sent[2] = 'Z'; sent[3] = 0;
    tp->check_true(d26.to_str(sent, 0) == sent, "Real.to_str: cap 0 returns the buffer");
    tp->check_eq_str(sent, "XYZ", "Real.to_str: cap 0 leaves it untouched");
    tp->check_eq_str(nzero.to_str(buf, 8), "-0", "Real.to_str: negative zero");
    tp->check_eq_str(inf.to_str(buf, 16), "inf", "Real.to_str: +inf");
    tp->check_eq_str(ninf.to_str(buf, 16), "-inf", "Real.to_str: -inf");
    tp->check_true(nan.to_str(buf, 16) == buf, "Real.to_str: NaN writes something");
    tp->check_eq_int(isnan(strtod(buf, 0)), 1, "Real.to_str: NaN text reads back as NaN");

    /* ---- Real: extreme magnitudes round-trip --------------------------- */
    r0 = dmax.to_string();
    tp->check_true(r0 != 0, "Real.to_string: DBL_MAX returns a pointer");
    tp->check_true(strlen(r0) < 32, "Real.to_string: DBL_MAX fits a ring slot");
    tp->check_true(strtod(r0, 0) == dmax, "Real.to_string: DBL_MAX round-trips");
    r1 = dmin.to_string();
    tp->check_true(strtod(r1, 0) == dmin, "Real.to_string: DBL_MIN round-trips");
    r2 = dtiny.to_string();
    tp->check_true(strtod(r2, 0) == dtiny, "Real.to_string: the smallest subnormal round-trips");

    /* ---- Real: the four-slot to_string ring ----------------------------- */
    r0 = one.to_string();
    r1 = nzero.to_string();
    r2 = neg.to_string();
    r3 = d26.to_string();
    tp->check_true(r0 != r1 && r1 != r2 && r2 != r3 && r0 != r3,
                  "Real.to_string: four live results take four slots");
    r4 = d25.to_string();
    tp->check_true(r4 == r0, "Real.to_string: the fifth call reuses slot 0");
    tp->check_eq_str(r0, "2.5", "Real.to_string: slot 0 now holds the fifth value");
    tp->check_eq_str(r1, "-0", "Real.to_string: slot 1 stayed intact");
    tp->check_eq_str(r2, "-3.5", "Real.to_string: slot 2 value");
    tp->check_eq_str(r3, "2.6", "Real.to_string: slot 3 value");

    return tp->report();
}

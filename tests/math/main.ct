/* std::math - the namespace pair (Math) and the value hosts (Float / Real). */
import std::math::Math;
import std::math::Real;
import std::test::Test;

#include <stdlib.h>

int main(void)
{
    Test t;
    Test *tp = &t;
    char buf[32];
    double x = 16.0;
    double neg = -3.5;
    double d = 2.6;
    double third = 1.0 / 3.0;
    double precise = 1.23456789;
    double zero = 0.0;
    double nan = zero / zero;
    double inf = 1.0 / zero;
    float f = -2.5f;
    float f26 = 2.6f;

    tp->init();

    tp->check_eq_int((int)std::math::Math.sqrt(x), 4, "Math.sqrt");
    tp->check_eq_int((int)std::math::Math.fabs(neg), 3, "Math.fabs");

    tp->check_eq_int((int)f.abs(), 2, "float abs");
    tp->check_eq_int((int)f.floor(), -3, "float floor");
    tp->check_eq_int((int)f26.ceil(), 3, "float ceil");
    tp->check_eq_int((int)f26.round(), 3, "float round");
    tp->check_eq_int((int)d.sqrt(), 1, "double sqrt");
    tp->check_eq_int((int)d.round(), 3, "double round");
    tp->check_true(nan.is_nan(), "is_nan");
    tp->check_true(inf.is_inf(), "is_inf");

    tp->check_eq_str(d.to_str(buf, 32), "2.6", "to_str keeps the short form");
    tp->check_eq_str(d.to_string(), "2.6", "to_string keeps the short form");
    tp->check_eq_str(precise.to_string(), "1.2345678899999999",
                   "17 digits when 6 do not round-trip");
    tp->check_true(atof(third.to_string()) == third, "to_string round-trips through atof");
    tp->check_true(atof(precise.to_str(buf, 32)) == precise, "to_str round-trips through atof");

    return tp->report();
}

/* std::num - the integer surfaces (Int / Long / LLong) and the ctype surface (Char).
 *
 * Every check uses a variable as the receiver: literal receivers are not valid
 * on a compiler without that feature. */
import std::num::Num;
import std::test::Test;

int main(void)
{
    Test t;
    Test *tp = &t;
    char buf[32];
    long v = 65;
    long a = 5;
    long b = 9;
    long neg = -77;
    long long ll = -88;
    int iv = 65;
    int ia = 5;
    int ib = 9;
    int ineg = -77;
    char digit = '7';
    char letter = 'a';
    char upper = 'A';

    tp->init();

    tp->check_eq_int((int)v.abs(), 65, "long abs");
    tp->check_eq_int((int)neg.abs(), 77, "long abs of a negative");
    tp->check_eq_int((int)a.clamp(0, 3), 3, "clamp");
    tp->check_eq_int((int)a.max(b), 9, "max");
    tp->check_eq_int((int)a.min(b), 5, "min");
    tp->check_eq_str(v.to_str(buf, 32), "65", "to_str");
    tp->check_eq_str(v.to_base(16, buf, 32), "41", "to_base 16");
    tp->check_true(v.to_base(16, buf, 2) == 0, "to_base refuses to truncate");

    tp->check_eq_int((int)ll.abs(), 88, "long long abs");
    tp->check_eq_str(ll.to_base(2, buf, 32), "-1011000", "long long to_base 2");

    tp->check_eq_int(iv.abs(), 65, "int abs");
    tp->check_eq_int(ineg.abs(), 77, "int abs of a negative");
    tp->check_eq_int(ia.clamp(0, 3), 3, "int clamp");
    tp->check_eq_int(ia.max(ib), 9, "int max");
    tp->check_eq_int(ia.min(ib), 5, "int min");
    tp->check_eq_str(iv.to_str(buf, 32), "65", "int to_str");
    tp->check_eq_str(iv.to_base(16, buf, 32), "41", "int to_base 16");
    tp->check_true(iv.to_base(16, buf, 2) == 0, "int to_base refuses to truncate");

    tp->check_eq_int(digit.is_digit(), 1, "is_digit");
    tp->check_true(letter.is_alpha(), "is_alpha");
    tp->check_true(!digit.is_alpha(), "is_alpha on a digit");
    tp->check_eq_int(letter.uppercase(), 'A', "uppercase");
    tp->check_eq_int(upper.lowercase(), 'a', "lowercase");
    tp->check_true(upper.is_upper(), "is_upper");
    tp->check_true(letter.is_lower(), "is_lower");

    return tp->report();
}

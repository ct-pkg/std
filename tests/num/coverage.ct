/* std::num - every method of the four hosts (Int / Long / LLong / Char), with
 * the buffer-capacity boundaries, the base conversions and the to_string ring.
 *
 * `abs(INT_MIN)` / `labs(LONG_MIN)` / `llabs(LLONG_MIN)` are undefined
 * behaviour in C (the result is not representable), so those calls are
 * deliberately not asserted; `INT_MIN + 1` and the stringification of the
 * minimum values are covered instead. */
import std::num::Num;
import std::test::Test;

#include <limits.h>

int main(void)
{
    Test t;
    Test *tp = &t;
    char buf[64];
    char sent[8];
    char *nullbuf = 0;
    char *r0;
    char *r1;
    char *r2;
    char *r3;
    char *r4;
    int i0 = 0;
    int i1 = -1;
    int i5 = 5;
    int i9 = 9;
    int i35 = 35;
    int i65 = 65;
    int i255 = 255;
    int im255 = -255;
    int ineg = -77;
    int ineg2 = -88;
    int imax = INT_MAX;
    int imin1 = INT_MIN + 1;
    int imin = INT_MIN;
    long l0 = 0;
    long l1 = -1;
    long l5 = 5;
    long l9 = 9;
    long l65 = 65;
    long lneg = -77;
    long l255 = 255;
    long lm255 = -255;
    long lmin1 = LONG_MIN + 1;
    long long ll0 = 0;
    long long llneg = -88;
    long long ll255 = 255;
    long long llm255 = -255;
    long long llmin = LLONG_MIN;
    long long llmin1 = LLONG_MIN + 1;
    char c0 = '0';
    char c9 = '9';
    char ca = 'a';
    char cz = 'z';
    char c_a = 'A';
    char c_z = 'Z';
    char c1 = '1';
    char csp = ' ';
    char ctab = '\t';
    char cnl = '\n';
    char cus = '_';
    char cneg = (char)-1;

    tp->init();

    /* ---- Int: abs / clamp / max / min -------------------------------- */
    tp->check_eq_int(i0.abs(), 0, "Int.abs: 0");
    tp->check_eq_int(i1.abs(), 1, "Int.abs: -1");
    tp->check_eq_int(imax.abs(), INT_MAX, "Int.abs: INT_MAX");
    tp->check_eq_int(imin1.abs(), INT_MAX, "Int.abs: INT_MIN+1");
    tp->check_eq_int(i65.clamp(0, 3), 3, "Int.clamp: above hi");
    tp->check_eq_int(ineg.clamp(0, 3), 0, "Int.clamp: below lo");
    tp->check_eq_int(i5.clamp(0, 9), 5, "Int.clamp: inside");
    tp->check_eq_int(i5.clamp(7, 7), 7, "Int.clamp: lo == hi");
    tp->check_eq_int(i5.max(i9), 9, "Int.max");
    tp->check_eq_int(i5.min(i9), 5, "Int.min");
    tp->check_eq_int(i5.max(5), 5, "Int.max: equal");
    tp->check_eq_int(ineg.max(ineg2), -77, "Int.max: negatives");
    tp->check_eq_int(ineg.min(ineg2), -88, "Int.min: negatives");

    /* ---- Int: to_str --------------------------------------------------- */
    buf[0] = 0;
    tp->check_true(i65.to_str(buf, 32) == buf, "Int.to_str: returns the buffer");
    tp->check_eq_str(buf, "65", "Int.to_str: 65");
    tp->check_true(i65.to_str(buf, 3) == buf, "Int.to_str: cap exactly");
    tp->check_eq_str(buf, "65", "Int.to_str: cap exactly value");
    tp->check_true(i65.to_str(buf, 2) == buf, "Int.to_str: cap one short succeeds");
    tp->check_eq_str(buf, "6", "Int.to_str: cap one short truncates silently");
    tp->check_true(i65.to_str(nullbuf, 32) == 0, "Int.to_str: NULL buffer returns NULL");
    sent[0] = 'X'; sent[1] = 'Y'; sent[2] = 'Z'; sent[3] = 0;
    tp->check_true(i65.to_str(sent, 0) == sent, "Int.to_str: cap 0 returns the buffer");
    tp->check_eq_str(sent, "XYZ", "Int.to_str: cap 0 leaves it untouched");
    tp->check_true(imin.to_str(buf, 12) == buf, "Int.to_str: INT_MIN cap exactly");
    tp->check_eq_str(buf, "-2147483648", "Int.to_str: INT_MIN value");
    tp->check_true(imin.to_str(buf, 11) == buf, "Int.to_str: INT_MIN cap one short");
    tp->check_eq_str(buf, "-214748364", "Int.to_str: INT_MIN truncates silently");

    /* ---- Int: to_base -------------------------------------------------- */
    tp->check_eq_str(i65.to_base(16, buf, 32), "41", "Int.to_base: 65/16");
    tp->check_eq_str(i5.to_base(2, buf, 32), "101", "Int.to_base: 5/2");
    tp->check_eq_str(i35.to_base(36, buf, 32), "z", "Int.to_base: 35/36");
    tp->check_eq_str(i0.to_base(2, buf, 2), "0", "Int.to_base: 0 fits cap 2");
    tp->check_true(i0.to_base(2, buf, 1) == 0, "Int.to_base: 0 needs cap 2");
    tp->check_eq_str(i255.to_base(16, buf, 3), "ff", "Int.to_base: 255/16 cap 3 exact");
    tp->check_true(i255.to_base(16, buf, 2) == 0, "Int.to_base: 255/16 cap 2 refused");
    tp->check_eq_str(im255.to_base(16, buf, 4), "-ff", "Int.to_base: -255/16 cap 4 exact");
    tp->check_true(im255.to_base(16, buf, 3) == 0, "Int.to_base: -255/16 cap 3 refused");
    tp->check_eq_str(imin.to_base(10, buf, 12), "-2147483648", "Int.to_base: INT_MIN cap 12 exact");
    tp->check_true(imin.to_base(10, buf, 11) == 0, "Int.to_base: INT_MIN cap 11 refused");
    tp->check_true(i5.to_base(1, buf, 32) == buf, "Int.to_base: base 1 returns the buffer");
    tp->check_eq_str(buf, "", "Int.to_base: base 1 is empty, not NULL");
    tp->check_true(i5.to_base(37, buf, 32) == buf, "Int.to_base: base 37 returns the buffer");
    tp->check_eq_str(buf, "", "Int.to_base: base 37 is empty, not NULL");
    tp->check_true(i65.to_base(16, nullbuf, 32) == 0, "Int.to_base: NULL buffer returns NULL");
    sent[0] = 'X'; sent[1] = 'Y'; sent[2] = 'Z'; sent[3] = 0;
    tp->check_true(i65.to_base(16, sent, 0) == sent, "Int.to_base: cap 0 returns the buffer");
    tp->check_eq_str(sent, "XYZ", "Int.to_base: cap 0 leaves it untouched");

    /* ---- Int: the four-slot to_string ring ----------------------------- */
    r0 = i0.to_string();
    r1 = i1.to_string();
    r2 = i5.to_string();
    r3 = i9.to_string();
    tp->check_true(r0 != r1 && r1 != r2 && r2 != r3 && r0 != r3,
                  "Int.to_string: four live results take four slots");
    r4 = i65.to_string();
    tp->check_true(r4 == r0, "Int.to_string: the fifth call reuses slot 0");
    tp->check_eq_str(r0, "65", "Int.to_string: slot 0 now holds the fifth value");
    tp->check_eq_str(r1, "-1", "Int.to_string: slot 1 stayed intact");
    tp->check_eq_str(r2, "5", "Int.to_string: slot 2 value");
    tp->check_eq_str(r3, "9", "Int.to_string: slot 3 value");

    /* ---- Long --------------------------------------------------------- */
    tp->check_eq_int((int)l0.abs(), 0, "Long.abs: 0");
    tp->check_eq_int((int)l1.abs(), 1, "Long.abs: -1");
    tp->check_eq_int((int)lneg.abs(), 77, "Long.abs: -77");
    tp->check_true(lmin1.abs() == LONG_MAX, "Long.abs: LONG_MIN+1");
    tp->check_eq_int((int)l65.clamp(0, 3), 3, "Long.clamp: above hi");
    tp->check_eq_int((int)lneg.clamp(-100, -50), -77, "Long.clamp: inside a negative range");
    tp->check_eq_int((int)lneg.clamp(-10, 10), -10, "Long.clamp: below lo");
    tp->check_eq_int((int)l5.max(l9), 9, "Long.max");
    tp->check_eq_int((int)l5.min(l9), 5, "Long.min");
    tp->check_eq_int((int)l5.max(5), 5, "Long.max: equal");
    tp->check_true(l65.to_str(buf, 32) == buf, "Long.to_str: returns the buffer");
    tp->check_eq_str(buf, "65", "Long.to_str: 65");
    tp->check_eq_str(lneg.to_string(), "-77", "Long.to_string: -77");
    tp->check_eq_str(l255.to_base(16, buf, 32), "ff", "Long.to_base: 255/16");
    tp->check_eq_str(lm255.to_base(16, buf, 4), "-ff", "Long.to_base: -255/16 cap 4 exact");
    tp->check_true(lm255.to_base(16, buf, 3) == 0, "Long.to_base: -255/16 cap 3 refused");
    tp->check_true(lmin1.to_base(10, buf, 32) != 0, "Long.to_base: LONG_MIN+1 emits");

    /* ---- LLong -------------------------------------------------------- */
    tp->check_eq_int((int)ll0.abs(), 0, "LLong.abs: 0");
    tp->check_eq_int((int)llneg.abs(), 88, "LLong.abs: -88");
    tp->check_true(llmin1.abs() == LLONG_MAX, "LLong.abs: LLONG_MIN+1");
    tp->check_eq_int((int)ll255.clamp(0, 3), 3, "LLong.clamp");
    tp->check_eq_int((int)llneg.max(ll255), 255, "LLong.max");
    tp->check_eq_int((int)llneg.min(ll255), -88, "LLong.min");
    tp->check_eq_str(ll255.to_str(buf, 32), "255", "LLong.to_str: 255");
    tp->check_eq_str(llneg.to_string(), "-88", "LLong.to_string: -88");
    tp->check_eq_str(ll255.to_base(2, buf, 32), "11111111", "LLong.to_base: 255/2");
    tp->check_eq_str(llm255.to_base(10, buf, 32), "-255", "LLong.to_base: -255/10");
    tp->check_true(llmin.to_str(buf, 21) == buf, "LLong.to_str: LLONG_MIN cap 21 exact");
    tp->check_eq_str(buf, "-9223372036854775808", "LLong.to_str: LLONG_MIN value");
    tp->check_true(llmin.to_str(buf, 20) == buf, "LLong.to_str: LLONG_MIN cap 20 succeeds");
    tp->check_eq_str(buf, "-922337203685477580", "LLong.to_str: LLONG_MIN truncates");
    tp->check_eq_str(llmin.to_base(10, buf, 21), "-9223372036854775808",
                   "LLong.to_base: LLONG_MIN cap 21 exact");
    tp->check_true(llmin.to_base(10, buf, 20) == 0, "LLong.to_base: LLONG_MIN cap 20 refused");

    /* ---- Char --------------------------------------------------------- */
    tp->check_eq_int(c0.is_digit(), 1, "Char.is_digit: '0'");
    tp->check_eq_int(c9.is_digit(), 1, "Char.is_digit: '9'");
    tp->check_eq_int(ca.is_digit(), 0, "Char.is_digit: 'a'");
    tp->check_eq_int(cus.is_digit(), 0, "Char.is_digit: '_'");
    tp->check_eq_int(cneg.is_digit(), 0, "Char.is_digit: negative char is safe");
    tp->check_eq_int(ca.is_alpha(), 1, "Char.is_alpha: 'a'");
    tp->check_eq_int(c_z.is_alpha(), 1, "Char.is_alpha: 'Z'");
    tp->check_eq_int(c1.is_alpha(), 0, "Char.is_alpha: '1'");
    tp->check_eq_int(cus.is_alpha(), 0, "Char.is_alpha: '_'");
    tp->check_eq_int(csp.is_space(), 1, "Char.is_space: space");
    tp->check_eq_int(ctab.is_space(), 1, "Char.is_space: tab");
    tp->check_eq_int(cnl.is_space(), 1, "Char.is_space: newline");
    tp->check_eq_int(ca.is_space(), 0, "Char.is_space: 'a'");
    tp->check_eq_int(c_a.is_upper(), 1, "Char.is_upper: 'A'");
    tp->check_eq_int(ca.is_upper(), 0, "Char.is_upper: 'a'");
    tp->check_eq_int(c1.is_upper(), 0, "Char.is_upper: '1'");
    tp->check_eq_int(ca.is_lower(), 1, "Char.is_lower: 'a'");
    tp->check_eq_int(c_a.is_lower(), 0, "Char.is_lower: 'A'");
    tp->check_eq_int(c1.is_lower(), 0, "Char.is_lower: '1'");
    tp->check_eq_int(ca.to_upper(), 'A', "Char.to_upper: 'a'");
    tp->check_eq_int(cz.to_upper(), 'Z', "Char.to_upper: 'z'");
    tp->check_eq_int(c1.to_upper(), '1', "Char.to_upper: non-letter unchanged");
    tp->check_eq_int(cus.to_upper(), '_', "Char.to_upper: punctuation unchanged");
    tp->check_eq_int(c_a.to_lower(), 'a', "Char.to_lower: 'A'");
    tp->check_eq_int(c_z.to_lower(), 'z', "Char.to_lower: 'Z'");
    tp->check_eq_int(c1.to_lower(), '1', "Char.to_lower: non-letter unchanged");
    tp->check_eq_int(cus.to_lower(), '_', "Char.to_lower: punctuation unchanged");

    return tp->report();
}

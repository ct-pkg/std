/* The runnable examples behind std/arena/README.md's tutorial.
 *
 * The gate builds and runs this file (tests/run.sh drives every *.ct in this
 * directory), so a broken example fails the build instead of rotting in the docs.
 *
 * Build and run by hand:
 *   ct build -I . tests/arena/guide.ct -o /tmp/guide && /tmp/guide
 */
import std::arena::Arena;
import std::test::Test;

int main(void)
{
    Test t;
    Test *tp = &t;
    Arena a;
    Arena *ap = &a;
    char *first;
    char *p;
    char *q;
    int i;

    tp->init();

    /* 1. init, then hand out aligned slices. */
    tp->check_eq_int(ap->init(32), 0, "init");
    p = (char *)ap->alloc(1);
    tp->check_true(p != 0, "alloc a byte");
    tp->check_eq_int((int)((long)p % 8), 0, "alloc is 8-byte aligned");
    first = p;
    q = (char *)ap->alloc(8);
    tp->check_true(q != 0, "alloc eight bytes");
    tp->check_eq_int((int)(q - p), 8, "a one-byte request still takes eight bytes");

    /* 2. Zero and negative requests are refused with NULL, not an abort. */
    tp->check_true(ap->alloc(0) == 0, "alloc of zero bytes is refused");
    tp->check_true(ap->alloc(-1) == 0, "alloc of a negative size is refused");

    /* 3. A request that does not fit the block gets a new block. */
    q = (char *)ap->alloc(40);
    tp->check_true(q != 0, "alloc across a block boundary");
    for (i = 0; i < 40; i++) q[i] = (char)i;
    tp->check_eq_int(q[39], (char)39, "the overflow block is writable");

    /* 4. reset: every block after the first goes back, the first is reused. */
    ap->reset();
    p = (char *)ap->alloc(8);
    tp->check_true(p != 0, "alloc after reset");
    tp->check_true(p == first, "reset recycles the first block");
    tp->check_eq_int((int)((long)p % 8), 0, "reset keeps the alignment");

    /* 5. free_all: even the first block goes, the arena refuses work until init. */
    ap->free_all();
    tp->check_true(ap->alloc(8) == 0, "alloc after free_all fails");
    tp->check_eq_int(ap->init(32), 0, "init makes the arena usable again");
    p = (char *)ap->alloc(8);
    tp->check_true(p != 0, "alloc after re-init");
    ap->free_all();

    return tp->report();
}

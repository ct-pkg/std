/* The runnable examples behind std/test/README.md's tutorial.
 *
 * The gate builds and runs this file (tests/run.sh drives every *.ct in this
 * directory), so a broken example fails the build instead of rotting in the docs.
 *
 * Build and run by hand:
 *   ct build -I . tests/test/guide.ct -o /tmp/guide && /tmp/guide
 */
import std::test::Test;

int main(void)
{
    Test t;
    Test *tp = &t;
    int ok;

    tp->init();

    /* 1. The three checks, all passing. */
    tp->check_true(1, "check_true");
    tp->check_eq_int(7, 7, "check_eq_int");
    tp->check_eq_str("hello", "hello", "check_eq_str");

    /* 2. Each check returns 1 on success and 0 on failure. */
    ok = tp->check_true(1, "returns 1");
    tp->check_eq_int(ok, 1, "check_true return value");
    ok = tp->check_eq_int(5, 5, "returns 1");
    tp->check_eq_int(ok, 1, "check_eq_int return value");
    ok = tp->check_eq_str("a", "a", "returns 1");
    tp->check_eq_int(ok, 1, "check_eq_str return value");

    /* 3. A NULL message is allowed; NULL strings compare as "". */
    tp->check_true(1, (char *)0);
    tp->check_eq_str((char *)0, "", "NULL got is empty");
    tp->check_eq_str("", (char *)0, "NULL want is empty");

    /* 4. The report is the exit status: 0 here, 1 when anything failed. */
    return tp->report();
}

/* Broader file-system coverage; the working docs are in std/fs/README.md.
 *
 * The gate builds and runs it (tests/run.sh drives every *.ct in this
 * directory) and passes argv[1] (a directory with exactly two entries) and
 * argv[2] (a file path outside it), so the listing assertions are
 * deterministic.
 *
 * Build and run by hand:
 *   ct build -I . tests/fs/guide.ct -o /tmp/guide
 *   /tmp/guide /tmp /tmp/ct-fs-guide.txt
 */
import std::fs::Fs;
import std::str::String;
import std::test::Test;

int main(int argc, char **argv)
{
    Test t;
    Test *tp = &t;
    char buf[64];
    char listing[128];
    char *dir;
    char *file;
    int n;

    tp->init();
    tp->check_eq_int(argc, 3, "the runner passes a directory and a file");
    if (argc < 3) return tp->report();

    dir = argv[1];
    file = argv[2];

    /* 1. exists: the receiver is any char *, and a missing path is 0. */
    tp->check_true(dir.exists(), "the directory exists");
    tp->check_true(!file.exists(), "the file does not exist yet");
    tp->check_eq_int("/no/such/path".exists(), 0, "a missing path is 0");
    tp->check_eq_int("".exists(), 0, "an empty string is not a path");

    /* 2. write then read; read reports BYTES written, not characters. */
    tp->check_eq_int(file.write("hello\nworld"), 0, "write the file");
    tp->check_true(file.exists(), "the file exists now");
    n = file.read(buf, 64);
    tp->check_eq_int(n, 11, "read returns the byte count");
    tp->check_eq_str(buf, "hello\nworld", "read value");
    tp->check_eq_int(file.read(buf, 11), -1,
                   "read needs room for the terminating NUL");
    tp->check_eq_int("/no/such/file".read(buf, 64), -1, "read a missing file");

    /* 3. list: entries joined with '\n', no trailing newline. */
    n = dir.list(listing, 128);
    tp->check_eq_int(n, 2, "list two entries");
    tp->check_true(listing.find("a.txt") >= 0, "the listing has a.txt");
    tp->check_true(listing.find("b.txt") >= 0, "the listing has b.txt");
    tp->check_true(listing.find_char('\n') >= 0, "entries are joined with a newline");
    tp->check_eq_int(dir.list(listing, 4), -1,
                   "list refuses a buffer that cannot hold the first name");
    tp->check_eq_int("/no/such/dir".list(listing, 128), -1, "list a missing directory");

    /* 4. write_file replaces: the old contents do not survive. */
    tp->check_eq_int(file.write("oo\n"), 0, "rewrite the file");
    n = file.read(buf, 64);
    tp->check_eq_int(n, 3, "read the rewritten file");
    tp->check_eq_str(buf, "oo\n", "rewritten value");

    /* 5. Bytes again: "é" is one character and two bytes on disk. */
    tp->check_eq_int(file.write("é"), 0, "write a multi-byte character");
    n = file.read(buf, 64);
    tp->check_eq_int(n, 2, "read counts bytes, not characters");

    return tp->report();
}

/* every std module in one program: the units must coexist in one build and the
   char * host must not have gained two methods with the same name. */
import std::arena::Arena;
import std::env::Env;
import std::errno::Errno;
import std::fs::Fs;
import std::io::File;
import std::io::Stdout;
import std::locale::LocaleHandle;
import std::math::Real;
import std::net::Socket;
import std::num::Num;
import std::process::Process;
import std::search::Search;
import std::str::String;
import std::test::Test;
import std::time::Time;
import std::utf8::Utf8Ops;
import std::wchar::Wchar;

int cmp_int(const void *a, const void *b)
{
    int x = *(const int *)a;
    int y = *(const int *)b;
    return (x > y) - (x < y);
}

int main(void)
{
    Test t;
    Test *tp = &t;
    Arena a;
    Arena *ap = &a;
    int v[3];
    int n;
    double d;
    int wide[8];
    int hits;
    char buf[64];
    char ip[32];

    tp->init();

    /* str / utf8 / fs */
    tp->check_eq_int("std".length(), 3, "str");
    tp->check_eq_int("std".count_codepoints(), 3, "utf8");
    tp->check_eq_int("/no/such/path".exists(), 0, "fs");

    /* num / math / search */
    n = 65;
    tp->check_eq_str(n.to_str(buf, 64), "65", "num");
    d = 16.0;
    tp->check_eq_int(d.sqrt(), 4, "math");
    v[0] = 3; v[1] = 1; v[2] = 2;
    std::search::Search.sort((char *)v, 3, 4, cmp_int);
    tp->check_eq_int(v[0], 1, "search");

    /* env / errno / locale / wchar */
    std::env::Env.set("CT_STD_EVERY", "1");
    tp->check_eq_int("CT_STD_EVERY".get_env(buf, 64), 1, "env");
    std::env::Env.unset("CT_STD_EVERY");
    std::errno::Errno.set_last(0);
    tp->check_eq_int(std::errno::Errno.get_last(), 0, "errno");
    tp->check_true(std::locale::current_locale(buf, 64) >= 0, "locale");
    tp->check_eq_int("ok".to_wide(wide, 8), 2, "wchar");

    /* process / time */
    tp->check_true(std::process::Process.get_pid() > 0, "process");
    tp->check_true(std::time::Time.now_seconds() > 0, "time");

    /* net (address helpers only; no sockets are opened) */
    tp->check_eq_int(std::net::Net.resolve_host("127.0.0.1", ip, 32), 0, "resolve_host");
    tp->check_eq_int("127.0.0.1".parse_ip(ip), 0, "parse_ip");

    /* io namespace */
    tp->check_eq_int(std::io::Stdout.write(""), 0, "io");

    /* arena / test */
    tp->check_eq_int(ap->init(16), 0, "arena");
    ap->free_all();

    hits = tp->report();
    return hits;
}

/* every std module in one program: the units must coexist in one build, and
   every call goes through the module's own spelling.

   The containers (`Vec<T>` / `Map<K,V>`) are not part of this package: they
   live in the compiler's built-in layer since ct 0.30.0, need no import, and
   were removed from `std` in 0.2.1 because declaring them here collides with
   the built-in names. */
import std::arena::Arena;
import std::fs::Fs;
import std::str::String;
import std::test::Test;
import std::utf8::Utf8Ops;

int main(void)
{
    Test t;
    Test *tp = &t;
    Arena a;
    Arena *ap = &a;
    char *p;
    char buf[16];
    int cp;

    tp->init();

    /* The three `char *` hosts (str / fs / utf8) coexist in one unit: str's
       `len` counts bytes, utf8's `count_codepoints` counts code points. */
    tp->check_eq_int("std".length(), 3, "str len counts bytes");
    tp->check_eq_int("std".count_codepoints(), 3, "utf8 count_codepoints on ASCII");
    tp->check_eq_int("é".count_codepoints(), 1, "one two-byte code point");
    tp->check_eq_int("é".length(), 2, "str len counts the same text as two bytes");
    tp->check_eq_int("A".decode(&cp), 1, "utf8 decode");
    tp->check_eq_int(cp, 65, "utf8 value");
    tp->check_eq_int(buf.encode(233, 16), 2, "utf8 encode");
    tp->check_eq_int(".".exists(), 1, "fs host");

    tp->check_eq_int(ap->init(16), 0, "arena init");
    p = (char *)ap->alloc(8);
    tp->check_true(p != 0, "arena alloc");
    ap->free_all();

    return tp->report();
}

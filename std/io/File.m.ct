namespace std::io;

/* `ct_io_file` is a private C type declared in File.shim.h. The alias below
   gives callers the only name they see (`IoFile`), so `File` maps onto
   `IoFile *` rather than the shared `void *` host. The `std_io_*` helpers keep
   their C signatures: they receive and return `ct_io_file *`, which is exactly
   what `IoFile *` denotes. */

pub type IoFile = struct ct_io_file;

pub trait Path {
    IoFile *open(const char *mode);
}

map trait Path for type char * {
    open(path, mode) -> std_io_open(path, mode);
}

pub trait File {
    int read(char *buf, int n);
    int write(const char *buf, int n);
    int close();
}

map trait File for type IoFile * {
    read(f, buf, n) -> std_io_read(f, buf, n);
    write(f, buf, n) -> std_io_write(f, buf, n);
    close(f) -> std_io_close(f);
}

/*
 * Real.m.ct - the value half of std::math (`float` / `double` methods).
 *
 * `float` keeps the `f`-suffixed libm entry points so the argument and the
 * result stay `float`; `double` uses the unsuffixed ones. `to_str` calls the
 * helper in `Real.shim.h`, which sits beside this file and shares its base name.
 * The text is round-trip exact: `%g` when it already reads back as the same
 * `double`, `%.17g` otherwise.
 *
 * Only `double` has `to_str`; `Float` stays purely numeric.
 *
 * License: MIT (see LICENSE).
 */
#include <math.h>

namespace std::math;

pub trait Float {
    float abs();
    float sqrt();
    float floor();
    float ceil();
    float round();
}

map trait Float for type float {
    abs(v) -> fabsf(v);
    sqrt(v) -> sqrtf(v);
    floor(v) -> floorf(v);
    ceil(v) -> ceilf(v);
    round(v) -> roundf(v);
}

pub trait Real {
    double  abs();
    double  sqrt();
    double  floor();
    double  ceil();
    double  round();
    int     is_nan();
    int     is_inf();
    char   *to_str(char *out, int cap);
}

map trait Real for type double {
    abs(v) -> fabs(v);
    sqrt(v) -> sqrt(v);
    floor(v) -> floor(v);
    ceil(v) -> ceil(v);
    round(v) -> round(v);
    is_nan(v) -> isnan(v);
    is_inf(v) -> isinf(v);
    to_str(v, out, cap) -> std_math_double_to_str(v, out, cap);
}

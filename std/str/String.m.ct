/*
 * String.m.ct - the method spellings for `char *` in std::str (std::str::String).
 *
 * Every binding is a zero-cost static mapping: `s.length()` expands at the call
 * site into `std_str_len(s)`, with no wrapper, no interface value and no
 * vtable. The functions it calls are defined `static inline` in String.shim.h;
 * this unit adds spelling only, never semantics.
 *
 * The trait is `CStrOps`, not `Str`: there is no `Str` struct here at all, and
 * a `pub trait Str` would still be a poor name beside the C `std_str_*` layer.
 * `CStrOps` is a distinct name, so nothing shadows it.
 *
 * `map trait ... for type` is legal only in `.m.ct`, so this is the only CT
 * unit of std::str; the C surface lives in the shim pair next to it, not in a
 * `.h.ct`.
 *
 * Every method here reads the receiver. Anything that produces bytes --
 * `copy`, `slice`, `concat`, `lowercase`, `uppercase` -- writes into a
 * caller-supplied buffer plus capacity and returns a status code; nothing
 * allocates and nothing mutates the receiver. The `to` prefix therefore does
 * not mean "returns a fresh value" either: `s.uppercase(out, cap)` still needs
 * the caller's buffer.
 *
 * The raw memory shapes stand apart from the string ones: `copy_from` and
 * `move_from` take the destination as the receiver and copy exactly `n` bytes,
 * with no NUL and no capacity check; `move_from` allows overlap. `fill` is the
 * `memset` shape. `compare_with` / `find_byte` / `compare_prefix` are the
 * `memcmp` / `memchr` / `strncmp` shapes. `split_into` copies fields into a
 * caller-supplied slot array and never touches the receiver.
 *
 * The host is `char *`. The compiler's type key drops a top-level `const`, so
 * a `const char *` receiver (a literal, or a `const char *` field) matches the
 * same host. That is harmless now: no method writes through the receiver, so a
 * literal is safe everywhere in this module.
 *
 * This unit is the only import: `import std::str::String;` brings the trait and
 * the shim, so the generated `.c` has the definitions it needs. The C functions
 * (`std_str_len`, ...) are still callable from C or from a raw
 * `#include "String.shim.h"` block -- they are `static inline`, so each
 * translation unit gets its own copy; the CT-level `std::str::length(...)` spelling
 * no longer exists.
 *
 * `to_int` / `to_double` are the C parsers (`atoi` / `atof`) behind the same
 * NULL check as the rest of the module: a missing receiver parses as 0.
 *
 * License: MIT (see LICENSE).
 */
#include <stdlib.h>

namespace std::str;

pub trait CStrOps {
    int length();
    int find(const char *needle);
    int find_char(int c);
    int starts_with(const char *prefix);
    int ends_with(const char *suffix);
    int copy(char *out, int cap);
    int slice(int start, int end, char *out, int cap);
    int concat(const char *other, char *out, int cap);
    int lowercase(char *out, int cap);
    int uppercase(char *out, int cap);
    int compare(const char *other);
    void copy_from(const char *src, int n);
    void move_from(const char *src, int n);
    void fill(int c, int n);
    int compare_with(const char *other, int n);
    char *find_byte(int c, int n);
    int compare_prefix(const char *other, int n);
    int split_into(const char *sep, char *out, int cap, int slot_size);
    int to_int();
    double to_double();
}

map trait CStrOps for type char * {
    length(s) -> std_str_len(s);
    find(s, needle) -> std_str_find(s, needle);
    find_char(s, c) -> std_str_find_char(s, c);
    starts_with(s, prefix) -> std_str_starts_with(s, prefix);
    ends_with(s, suffix) -> std_str_ends_with(s, suffix);
    copy(s, out, cap) -> std_str_copy(s, out, cap);
    slice(s, start, end, out, cap) -> std_str_slice(s, start, end, out, cap);
    concat(s, other, out, cap) -> std_str_concat(s, other, out, cap);
    lowercase(s, out, cap) -> std_str_lower(s, out, cap);
    uppercase(s, out, cap) -> std_str_upper(s, out, cap);
    compare(s, other) -> std_str_compare(s, other);
    copy_from(dst, src, n) -> std_str_copy_from(dst, src, n);
    move_from(dst, src, n) -> std_str_move_from(dst, src, n);
    fill(dst, c, n) -> std_str_fill(dst, c, n);
    compare_with(a, b, n) -> std_str_compare_with(a, b, n);
    find_byte(s, c, n) -> std_str_find_byte(s, c, n);
    compare_prefix(a, b, n) -> std_str_compare_prefix(a, b, n);
    split_into(s, sep, out, cap, slot_size) -> std_str_split_into(s, sep, out, cap, slot_size);
    to_int(s) -> std_str_to_int(s);
    to_double(s) -> std_str_to_double(s);
}

/* Poll.m.ct - POSIX poll; pollfd arrays are opaque handles. */
namespace std::poll;

pub trait Poll {
    void *new_set(int count);
    int set_fd(void *set, int index, int fd, int events);
    int events(void *set, int index);
    int wait(void *set, int count, int timeout);
    void free_set(void *set);
    int in();
    int out();
    int error();
    int hangup();
    int invalid();
    void *new_fd_set();
    int fd_set_add(void *set, int fd);
    int fd_set_remove(void *set, int fd);
    int fd_set_isset(void *set, int fd);
    int select_wait(void *read_set, void *write_set, void *except_set, int timeout_ms);
    void fd_set_free(void *set);
}

map trait Poll for namespace std::poll {
    new_set(count) -> std_poll_new(count);
    set_fd(set, index, fd, events) -> std_poll_set_fd(set, index, fd, events);
    events(set, index) -> std_poll_events(set, index);
    wait(set, count, timeout) -> std_poll_wait(set, count, timeout);
    free_set(set) -> std_poll_free(set);
    in() -> std_poll_in();
    out() -> std_poll_out();
    error() -> std_poll_err();
    hangup() -> std_poll_hup();
    invalid() -> std_poll_nval();
    new_fd_set() -> std_select_new_set();
    fd_set_add(set, fd) -> std_select_add(set, fd);
    fd_set_remove(set, fd) -> std_select_remove(set, fd);
    fd_set_isset(set, fd) -> std_select_isset(set, fd);
    select_wait(r, w, e, timeout_ms) -> std_select_wait(r, w, e, timeout_ms);
    fd_set_free(set) -> std_select_free(set);
}

/*
 * Env.m.ct - environment variables behind std::env.
 *
 * `getenv` returns a borrowed pointer into the process environment; the method
 * layer copies it into the caller's buffer instead of handing the pointer out,
 * so there is one spelling with a lifetime rule that is easy to state:
 * `name.get_env(out, cap)` writes at most `cap` bytes (terminator included) and
 * returns the byte count, or -1 when the name is unset or the value does not
 * fit. An empty value is a successful 0, not a miss.
 *
 * `set` / `unset` have no receiver worth naming, so they hang off the namespace
 * (`std::env::Env.set(name, value)`). `setenv` is called with overwrite=1:
 * setting an existing name replaces it. `putenv` is not wrapped at all -- it
 * takes ownership of the caller's string, which is a lifetime rule this module
 * does not want to carry.
 *
 * License: MIT (see LICENSE).
 */

namespace std::env;

pub trait EnvOps {
    int get_env(char *out, int cap);
}

map trait EnvOps for type char * {
    get_env(name, out, cap) -> std_env_get(name, out, cap);
}

pub trait Env {
    int set(const char *name, const char *value);
    int unset(const char *name);
}

map trait Env for namespace std::env {
    set(name, value) -> std_env_set(name, value);
    unset(name) -> std_env_unset(name);
}
